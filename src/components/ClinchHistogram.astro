---
import { getTeam } from '../engine/teams.ts';
import { percent, shortDate } from '../lib/format.ts';
import type { LeagueSnapshot } from '../lib/snapshot.ts';

interface Props {
	snapshot: LeagueSnapshot;
}

const { snapshot } = Astro.props;

/**
 * 優勝決定日のヒストグラム。ビルド時に SVG を組み立てるので JS は 0KB。
 * 棒は「その日に誰が決めるか」を球団カラーで積み上げる。
 */
const points = snapshot.clinchDateDistribution;
const contenders = snapshot.standings.filter((team) => team.championProbability > 0.0005);

// 日ごと・球団ごとの確率
const byDate = points.map((point) => ({
	date: point.date,
	cumulative: point.cumulative,
	total: point.probability,
	segments: contenders
		.map((team) => ({
			teamId: team.teamId,
			value: team.clinchDates.find((d) => d.date === point.date)?.probability ?? 0
		}))
		.filter((segment) => segment.value > 0)
}));

const peak = Math.max(0.02, ...byDate.map((d) => d.total));
const width = 720;
const height = 220;
const padLeft = 34;
const padRight = 8;
const padTop = 12;
const padBottom = 46;
const plotWidth = width - padLeft - padRight;
const plotHeight = height - padTop - padBottom;
const slot = byDate.length > 0 ? plotWidth / byDate.length : plotWidth;
const barWidth = Math.max(3, Math.min(26, slot - 3));

const yTicks = [0, 0.05, 0.1, 0.15, 0.2].filter((t) => t <= peak * 1.05);
const median = snapshot.clinchDateSummary?.median ?? null;
---

<figure class="card p-4">
	<figcaption class="mb-3">
		<h3 class="text-sm font-semibold">優勝決定日の確率分布</h3>
		<p style="color: var(--ink-soft)" class="mt-1 text-xs">
			{
				snapshot.iterations.toLocaleString('ja-JP')
			}回のシミュレーションで、優勝が数学的に確定した日。
			{
				median && (
					<>
						中央値は<strong style="color: var(--ink)">{shortDate(median)}</strong>、 80%の確率で{' '}
						{shortDate(snapshot.clinchDateSummary!.p10)} 〜{' '}
						{shortDate(snapshot.clinchDateSummary!.p90)} に決まる。
					</>
				)
			}
		</p>
	</figcaption>

	<div class="scroll-x">
		<svg
			viewBox={`0 0 ${width} ${height}`}
			width="100%"
			style="min-width: 640px; height: auto"
			role="img"
			aria-label="優勝決定日ごとの確率を示す棒グラフ"
		>
			{
				yTicks.map((tick) => {
					const y = padTop + plotHeight - (tick / peak) * plotHeight;
					return (
						<g>
							<line
								x1={padLeft}
								x2={width - padRight}
								y1={y}
								y2={y}
								stroke="var(--line)"
								stroke-width="1"
							/>
							<text
								x={padLeft - 6}
								y={y + 3.5}
								text-anchor="end"
								font-size="10"
								fill="var(--ink-faint)"
							>
								{Math.round(tick * 100)}%
							</text>
						</g>
					);
				})
			}

			{
				byDate.map((day, index) => {
					const x = padLeft + index * slot + (slot - barWidth) / 2;
					let offset = 0;
					const showLabel = byDate.length <= 12 || index % 2 === 0;
					return (
						<g>
							{day.segments.map((segment) => {
								const barHeight = (segment.value / peak) * plotHeight;
								const y = padTop + plotHeight - offset - barHeight;
								offset += barHeight;
								return (
									<rect
										x={x}
										y={y}
										width={barWidth}
										height={Math.max(0.5, barHeight)}
										fill={getTeam(segment.teamId).color}
										rx="1.5"
									>
										<title>
											{shortDate(day.date)} {getTeam(segment.teamId).short} {percent(segment.value)}
										</title>
									</rect>
								);
							})}
							{showLabel && (
								<text
									x={x + barWidth / 2}
									y={padTop + plotHeight + 14}
									text-anchor="middle"
									font-size="9.5"
									fill="var(--ink-faint)"
								>
									{day.date.slice(5).replace('-', '/')}
								</text>
							)}
						</g>
					);
				})
			}

			<line
				x1={padLeft}
				x2={width - padRight}
				y1={padTop + plotHeight}
				y2={padTop + plotHeight}
				stroke="var(--line-strong)"
				stroke-width="1"></line>
		</svg>
	</div>

	<div class="mt-3 flex flex-wrap gap-x-4 gap-y-1 text-xs">
		{
			contenders.map((team) => (
				<span class="flex items-center gap-1.5">
					<span
						aria-hidden="true"
						class="inline-block h-2.5 w-2.5 rounded-sm"
						style={`background: ${getTeam(team.teamId).color}`}
					/>
					<span>{getTeam(team.teamId).short}</span>
					<span style="color: var(--ink-faint)">{percent(team.championProbability)}</span>
				</span>
			))
		}
	</div>

	{
		snapshot.tiebreakDecidedRate > 0.001 && (
			<p style="color: var(--ink-faint)" class="mt-3 text-xs">
				うち {percent(snapshot.tiebreakDecidedRate)}{' '}
				は勝率が完全に並び、当該球団間の対戦成績で優勝が決まるケース（最終日に計上）。
			</p>
		)
	}
</figure>
